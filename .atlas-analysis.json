  "keyFeatures": [
    "Service ingestion from OpenAPI, GraphQL, Postman Collections, Docs URLs, and internal APIs",
    "Auto-generated typed SDKs in TypeScript and Python — no vendor runtime dependency",
    "MCP server generation with search_docs and execute_tool capabilities",
    "Typed webhook receivers delivered over outbound WebSocket connections",
    "Centralised auth, retries, tracing, and error handling across all generated artefacts",
    "Drift detection to keep generated artefacts in sync when upstream APIs change",
    "fused-cli for natural language SDK and MCP generation from the terminal",
    "Fused-Run managed cloud hosting for TypeScript MCP servers"
  ],
  "publicApiSurface": [
    "fused-cli create --name <name> --type sdk|mcp --language typescript|python --deploy -d \"<description>\"",
    "fused-cli update <sdk-name>[@version] --type --language --deploy",
    "fused-cli download <sdk-name>[@version] --output <dir>",
    "FUSED_API_KEY environment variable / --api-key flag",
    "FusedSDK constructor (generated, named per business domain)",
    "fusedWebhooks.registerReceiver(name, apiKey)",
    "receiver.on(EventEnum, handler)",
    "MCP tool: search_docs(query)",
    "MCP tool: execute_tool(typescript_code)"
  ]
}
